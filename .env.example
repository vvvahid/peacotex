# Copy to .env.local and fill in. Never commit real keys.

# Local development: an embedded PostgreSQL (PGlite) stored in ./.data.
# Production: a managed PostgreSQL URL, e.g. postgres://user:pass@host/db (Neon, Supabase, Vercel Postgres).
DATABASE_URL=pglite://.data/peacotex

# Stripe → Developers → API keys. Use the TEST key (sk_test_…) until launch.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → endpoint https://<your-site>/api/stripe/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
# Optional locally: the success page also confirms payments with Stripe directly.
STRIPE_WEBHOOK_SECRET=

# Public base URL used for Stripe return links (optional; defaults to the request origin).
NEXT_PUBLIC_SITE_URL=

# Admin at /admin: the password for signing in (long and unique; never commit it).
ADMIN_PASSWORD=
# Optional: a long random string that signs admin sessions (changing it signs everyone out).
ADMIN_SESSION_SECRET=
